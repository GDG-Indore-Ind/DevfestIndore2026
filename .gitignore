# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Browser-safe build output; SQLite is the single editable domain source.
/src/content/generated/
/content/*.sqlite-journal
/content/*.sqlite-wal
/content/*.sqlite-shm
/content/*.importing
/content/*.restoring

# Large local media & raw photoshoot dumps
drive-download*
*.JPG
!public/gallery/**
!public/images/team/**
!public/images/partners/**
!public/images/press/**
!public/images/venue-*.jpg
*.CR2

local_storage_private/
/docs/profile-review/generated/
*.pdf
DevFest 2026 Indore _ Sponsorship Deck (1).pdf
*-firebase-adminsdk-*.json

# per-machine Claude Code settings
/.claude/settings.local.json

# raw photos waiting for `npm run photos`
/photos-inbox/
.claude/
