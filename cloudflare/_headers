# Cloudflare Pages response headers. Copied to out/_headers by `npm run build:cloudflare`.
# Pages serves HTML with `max-age=0, must-revalidate` by default, which suits event content
# that changes between deploys, so only fingerprinted or rarely changed assets are overridden.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Next.js fingerprints everything under /_next/static, so it can be cached permanently.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# These files keep stable names, so allow reuse without freezing a replaced photo or logo.
/fonts/*
  Cache-Control: public, max-age=604800
/images/*
  Cache-Control: public, max-age=86400
/gallery/*
  Cache-Control: public, max-age=86400

# Keep per-deployment preview URLs (<hash>.<project>.pages.dev) out of search results.
# The production <project>.pages.dev host is not matched.
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
