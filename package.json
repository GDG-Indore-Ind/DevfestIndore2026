{
  "name": "devfest-indore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "content:validate": "node scripts/validate-content.mjs",
    "predev": "npm run images && npm run content:validate",
    "prebuild": "npm run images && npm run content:validate",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"src/**/*.module.css\" src/app/tokens.css",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"src/**/*.module.css\" src/app/tokens.css",
    "check": "npm run content:validate && npm run content:test && npm run typecheck && npm run lint && npm run format:check",
    "content:test": "node --test scripts/content-model.test.mjs",
    "photos": "node scripts/photos.mjs",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^6.15.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
