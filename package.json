{
  "name": "devfest-indore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "build:cloudflare": "DEVFEST_STATIC_EXPORT=1 npm run build && node scripts/cloudflare-redirects.mjs && node scripts/cloudflare-headers.mjs",
    "start": "next start",
    "lint": "eslint",
    "content:validate": "node scripts/validate-content.mjs",
    "predev": "npm run images && npm run content:generate",
    "prebuild": "npm run images && npm run content:generate",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"src/**/*.module.css\" src/app/tokens.css",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"src/**/*.module.css\" src/app/tokens.css",
    "check": "npm run db:check && npm run content:generate && npm run content:test && npm run typecheck && npm run lint && npm run format:check",
    "content:test": "node --test scripts/content-model.test.mjs scripts/database.test.mjs",
    "photos": "node scripts/photos.mjs",
    "images": "node scripts/optimize-images.mjs",
    "content:generate": "node scripts/generate-content.mjs",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:export": "node scripts/database.mjs export",
    "db:check": "node scripts/database.mjs check",
    "db:restore": "node scripts/database.mjs restore"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.49.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^6.15.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^4.6.7"
  }
}
