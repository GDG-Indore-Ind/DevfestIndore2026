{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "participations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "personId": {
            "type": "string",
            "minLength": 1
          },
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "core-team",
                    "volunteer",
                    "ambassador",
                    "speaker"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "responsibilities": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "area": { "type": "string", "minLength": 1 },
                      "level": { "enum": ["lead", "co-lead", "coordinator", "team-member", "volunteer"] }
                    },
                    "required": ["area", "level"]
                  }
                },
                "order": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "kind",
                "title",
                "order"
              ]
            }
          }
        },
        "required": [
          "id",
          "personId",
          "eventId",
          "roles"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "participations"
  ]
}
