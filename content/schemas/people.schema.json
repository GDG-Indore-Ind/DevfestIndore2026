{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevFest people",
  "description": "Authoritative public website content. Do not store private contact details or tentative announcements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "person",
              "group"
            ]
          },
          "bio": {
            "type": "string"
          },
          "photo": {
            "type": "string",
            "pattern": "^(https://|/[^/])"
          },
          "links": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "linkedin": {
                "type": "string"
              },
              "twitter": {
                "type": "string"
              },
              "github": {
                "type": "string"
              },
              "instagram": {
                "type": "string"
              },
              "website": {
                "type": "string"
              },
              "blog": {
                "type": "string"
              }
            },
            "required": []
          },
          "profession": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "organization": {
                "type": "string"
              }
            },
            "minProperties": 1
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "eventId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceUrl": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "roles": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "enum": [
                          "core-team",
                          "volunteer",
                          "ambassador",
                          "speaker"
                        ]
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "responsibilities": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "area": {
                              "type": "string",
                              "minLength": 1
                            },
                            "level": {
                              "enum": [
                                "lead",
                                "co-lead",
                                "coordinator",
                                "team-member",
                                "volunteer"
                              ]
                            }
                          },
                          "required": [
                            "area",
                            "level"
                          ]
                        }
                      },
                      "order": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "kind",
                      "title",
                      "order"
                    ]
                  }
                },
                "displayOrder": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "eventId",
                "roles",
                "displayOrder"
              ]
            }
          },
          "undatedTeam": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "team": {
                  "enum": [
                    "Core Organizer",
                    "Design & Experience",
                    "Tech & Operations",
                    "Space & Ecosystem",
                    "Community"
                  ]
                },
                "order": {
                  "type": "integer",
                  "minimum": 0
                },
                "bio": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "role",
                "team",
                "order"
              ]
            }
          },
          "teamAssignments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "eventId": {
                  "type": "string",
                  "minLength": 1
                },
                "category": {
                  "enum": [
                    "core-team",
                    "volunteer"
                  ]
                },
                "responsibilities": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "displayOrder": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "eventId",
                "category",
                "responsibilities",
                "displayOrder"
              ]
            }
          },
          "ambassador": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "community",
              "contactPlatforms",
              "order"
            ],
            "properties": {
              "community": {
                "type": "string",
                "minLength": 1
              },
              "contactPlatforms": {
                "type": "array",
                "minItems": 0,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "linkedin"
                  ]
                }
              },
              "order": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "people"
  ]
}
