{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "person",
              "group"
            ]
          },
          "title": {
            "description": "Current job title, e.g. Senior Engineer.",
            "type": "string",
            "minLength": 1
          },
          "organization": {
            "description": "Current employer or community, e.g. Qualcomm.",
            "type": "string",
            "minLength": 1
          },
          "bio": {
            "description": "Plain text; use a blank line between paragraphs. Put profile URLs under links.",
            "type": "string"
          },
          "photo": {
            "type": "string",
            "pattern": "^(https:\\/\\/|\\/[^/])"
          },
          "links": {
            "type": "object",
            "properties": {
              "linkedin": {
                "type": "string"
              },
              "twitter": {
                "type": "string"
              },
              "github": {
                "type": "string"
              },
              "instagram": {
                "type": "string"
              },
              "website": {
                "type": "string"
              },
              "blog": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "events": {
            "description": "One entry per event this person took part in, naming their roles there.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "eventId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceUrl": {
                  "type": "string",
                  "pattern": "^https:\\/\\/",
                  "format": "uri"
                },
                "roles": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "title": {
                            "description": "Overrides the default role label, e.g. Keynote speaker.",
                            "type": "string",
                            "minLength": 1
                          },
                          "order": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "kind": {
                            "type": "string",
                            "const": "speaker"
                          }
                        },
                        "required": [
                          "kind"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "title": {
                            "description": "Overrides the default role label, e.g. Keynote speaker.",
                            "type": "string",
                            "minLength": 1
                          },
                          "order": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "kind": {
                            "type": "string",
                            "const": "core-team"
                          },
                          "responsibilities": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "area": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "level": {
                                  "type": "string",
                                  "enum": [
                                    "lead",
                                    "co-lead",
                                    "coordinator",
                                    "team-member",
                                    "volunteer"
                                  ]
                                }
                              },
                              "required": [
                                "area"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "kind",
                          "responsibilities"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "title": {
                            "description": "Overrides the default role label, e.g. Keynote speaker.",
                            "type": "string",
                            "minLength": 1
                          },
                          "order": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "kind": {
                            "type": "string",
                            "const": "volunteer"
                          },
                          "responsibilities": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "area": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "level": {
                                  "type": "string",
                                  "enum": [
                                    "lead",
                                    "co-lead",
                                    "coordinator",
                                    "team-member",
                                    "volunteer"
                                  ]
                                }
                              },
                              "required": [
                                "area"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "kind",
                          "responsibilities"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "title": {
                            "description": "Overrides the default role label, e.g. Keynote speaker.",
                            "type": "string",
                            "minLength": 1
                          },
                          "order": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "kind": {
                            "type": "string",
                            "const": "ambassador"
                          },
                          "track": {
                            "type": "string",
                            "enum": [
                              "professional",
                              "student"
                            ]
                          },
                          "community": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "kind",
                          "track",
                          "community"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "eventId",
                "roles"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "people"
  ],
  "additionalProperties": false,
  "title": "DevFest people",
  "description": "Generated from the Zod schema for content/people.json; do not edit."
}
