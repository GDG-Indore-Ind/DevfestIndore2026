{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevFest people",
  "description": "Authoritative public website content. Do not store private contact details or tentative announcements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "person",
              "group"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Current job title, e.g. Senior Engineer."
          },
          "organization": {
            "type": "string",
            "minLength": 1,
            "description": "Current employer or community, e.g. Qualcomm."
          },
          "bio": {
            "type": "string",
            "description": "Plain text; use a blank line between paragraphs. Put profile URLs under links."
          },
          "photo": {
            "type": "string",
            "pattern": "^(https://|/[^/])"
          },
          "links": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "linkedin": {
                "type": "string"
              },
              "twitter": {
                "type": "string"
              },
              "github": {
                "type": "string"
              },
              "instagram": {
                "type": "string"
              },
              "website": {
                "type": "string"
              },
              "blog": {
                "type": "string"
              }
            },
            "required": []
          },
          "events": {
            "type": "array",
            "description": "One entry per event this person took part in, naming their roles there.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "eventId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceUrl": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "roles": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/role"
                  }
                }
              },
              "required": [
                "eventId",
                "roles"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "people"
  ],
  "definitions": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "description": "What a person did at one event. Speaker needs nothing more; team roles list responsibilities; ambassadors give a track and community. order is optional and sorts within this role kind at the event (lowest first, ties keep file order).",
      "properties": {
        "kind": {
          "enum": [
            "speaker",
            "core-team",
            "volunteer",
            "ambassador"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Overrides the default label, e.g. Keynote speaker."
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "area": {
                "type": "string",
                "minLength": 1
              },
              "level": {
                "enum": [
                  "lead",
                  "co-lead",
                  "coordinator",
                  "team-member",
                  "volunteer"
                ]
              }
            },
            "required": [
              "area"
            ]
          }
        },
        "track": {
          "enum": [
            "professional",
            "student"
          ]
        },
        "community": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "core-team",
                  "volunteer"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "responsibilities"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "track"
                  ]
                },
                {
                  "required": [
                    "community"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ambassador"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "track",
              "community"
            ],
            "not": {
              "required": [
                "responsibilities"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "speaker"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "responsibilities"
                  ]
                },
                {
                  "required": [
                    "track"
                  ]
                },
                {
                  "required": [
                    "community"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
