{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevFest themes",
  "description": "Authoritative public website content. Do not store private contact details or tentative announcements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "enum": [
              "Satellite",
              "Braces",
              "Bot",
              "Radio"
            ]
          },
          "color": {
            "enum": [
              "blue",
              "red",
              "yellow",
              "green"
            ]
          },
          "signal": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "route": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stripLabel": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "icon",
          "color",
          "signal",
          "title",
          "description",
          "tags",
          "route"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "$schema",
    "themes"
  ]
}
