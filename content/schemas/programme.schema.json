{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevFest programme",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "eventId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "publication": {
                "enum": [
                  "confirmed",
                  "archived"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string"
              },
              "company": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "spotlightBadge": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "GenAI",
                  "Cloud",
                  "Mobile & Flutter",
                  "Web",
                  "Leadership & Ecosystem",
                  "Space Technology",
                  "Physical AI & Robotics",
                  "Data & Systems"
                ]
              },
              "track": {
                "type": "string"
              },
              "level": {
                "type": "string"
              },
              "profile": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "avatar": {
                    "type": "string",
                    "pattern": "^(https://|/[^/])"
                  },
                  "bio": {
                    "type": "string"
                  },
                  "socials": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "linkedin": {
                        "type": "string"
                      },
                      "twitter": {
                        "type": "string"
                      },
                      "github": {
                        "type": "string"
                      },
                      "instagram": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      },
                      "website": {
                        "type": "string"
                      },
                      "blog": {
                        "type": "string"
                      }
                    },
                    "required": []
                  }
                },
                "required": []
              },
              "time": {
                "type": "string"
              },
              "hall": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "speakerIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              },
              "resources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://"
                    }
                  },
                  "required": [
                    "label",
                    "url"
                  ]
                }
              },
              "speakerProfiles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "personId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "type": "string"
                    },
                    "company": {
                      "type": "string"
                    },
                    "profile": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "avatar": {
                          "type": "string",
                          "pattern": "^(https://|/[^/])"
                        },
                        "bio": {
                          "type": "string"
                        },
                        "socials": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "linkedin": {
                              "type": "string"
                            },
                            "twitter": {
                              "type": "string"
                            },
                            "github": {
                              "type": "string"
                            },
                            "instagram": {
                              "type": "string"
                            },
                            "email": {
                              "type": "string"
                            },
                            "website": {
                              "type": "string"
                            },
                            "blog": {
                              "type": "string"
                            }
                          },
                          "required": []
                        }
                      },
                      "required": []
                    }
                  },
                  "required": [
                    "personId"
                  ]
                }
              },
              "format": {
                "enum": [
                  "talk",
                  "keynote",
                  "panel",
                  "workshop"
                ]
              },
              "sourceUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "type": {
                "const": "talk"
              }
            },
            "required": [
              "id",
              "eventId",
              "publication",
              "title",
              "role",
              "company",
              "description",
              "spotlightBadge",
              "category",
              "speakerIds",
              "type"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "campus",
              "speakerIds",
              "publication",
              "photoIds",
              "type"
            ],
            "dependencies": {
              "date": [
                "eventUrl"
              ]
            },
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "campus": {
                "type": "string",
                "minLength": 1
              },
              "speakerIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              },
              "publication": {
                "enum": [
                  "archived",
                  "confirmed"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "eventUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://gdg\\.community\\.dev/events/details/[^?#]+/?$"
              },
              "type": {
                "const": "campus-workshop"
              },
              "legacyId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "photoIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              }
            }
          }
        ]
      }
    }
  }
}
