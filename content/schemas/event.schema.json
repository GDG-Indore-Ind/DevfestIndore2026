{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "events": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "organizer": {
                "type": "string",
                "minLength": 1
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              },
              "tagline": {
                "type": "string",
                "minLength": 1
              },
              "subTagline": {
                "type": "string",
                "minLength": 1
              },
              "contactEmail": {
                "type": "string",
                "format": "email"
              },
              "venue": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fullName": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tag": {
                    "type": "string",
                    "minLength": 1
                  },
                  "address": {
                    "type": "string",
                    "minLength": 1
                  },
                  "streetAddress": {
                    "type": "string",
                    "minLength": 1
                  },
                  "city": {
                    "type": "string",
                    "minLength": 1
                  },
                  "region": {
                    "type": "string",
                    "minLength": 1
                  },
                  "postalCode": {
                    "type": "string",
                    "minLength": 1
                  },
                  "country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  },
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "mapUrl": {
                    "type": "string",
                    "pattern": "^https:\\/\\/",
                    "format": "uri"
                  },
                  "photo": {
                    "type": "string",
                    "pattern": "^(https:\\/\\/|\\/[^\\/])"
                  }
                },
                "required": [
                  "name",
                  "fullName",
                  "tag",
                  "address",
                  "streetAddress",
                  "city",
                  "region",
                  "postalCode",
                  "country",
                  "latitude",
                  "longitude",
                  "mapUrl",
                  "photo"
                ],
                "additionalProperties": false
              },
              "links": {
                "type": "object",
                "properties": {
                  "website": {
                    "type": "string",
                    "pattern": "^https:\\/\\/",
                    "format": "uri"
                  },
                  "cfp": {
                    "type": "string",
                    "pattern": "^https:\\/\\/",
                    "format": "uri"
                  },
                  "linkedin": {
                    "type": "string",
                    "pattern": "^https:\\/\\/",
                    "format": "uri"
                  },
                  "instagram": {
                    "type": "string",
                    "pattern": "^https:\\/\\/",
                    "format": "uri"
                  },
                  "chapter": {
                    "type": "string",
                    "pattern": "^https:\\/\\/",
                    "format": "uri"
                  },
                  "youtube": {
                    "type": "string",
                    "pattern": "^https:\\/\\/",
                    "format": "uri"
                  },
                  "github": {
                    "type": "string",
                    "pattern": "^https:\\/\\/",
                    "format": "uri"
                  },
                  "twitter": {
                    "type": "string",
                    "pattern": "^https:\\/\\/",
                    "format": "uri"
                  },
                  "codeOfConduct": {
                    "type": "string",
                    "pattern": "^https:\\/\\/",
                    "format": "uri"
                  },
                  "partnerApplication": {
                    "type": "string",
                    "pattern": "^https:\\/\\/",
                    "format": "uri"
                  },
                  "exhibitApplication": {
                    "type": "string",
                    "pattern": "^https:\\/\\/",
                    "format": "uri"
                  }
                },
                "required": [
                  "website",
                  "cfp",
                  "linkedin",
                  "instagram",
                  "chapter",
                  "youtube",
                  "github",
                  "twitter",
                  "codeOfConduct",
                  "partnerApplication",
                  "exhibitApplication"
                ],
                "additionalProperties": false
              },
              "tickets": {
                "type": "object",
                "properties": {
                  "passes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "enum": [
                            "liftoff",
                            "student",
                            "professional",
                            "vip",
                            "last-orbit",
                            "observer"
                          ]
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "audience": {
                          "type": "string",
                          "minLength": 1
                        },
                        "visible": {
                          "type": "boolean",
                          "description": "Show this pass card on the public tickets page. Register links hand off availability to KonfHub."
                        },
                        "summary": {
                          "type": "string",
                          "minLength": 1
                        },
                        "allocation": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "price": {
                          "description": "Approved base price in INR. Omit until confirmed; zero is a real free price.",
                          "type": "number",
                          "minimum": 0
                        },
                        "offers": {
                          "description": "Short public discount line shown under the price, such as a group discount.",
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "bookingRoute": {
                          "description": "Where the pass card sends visitors. Omit for the KonfHub widget; ambassador sends them to the ambassador directory.",
                          "type": "string",
                          "enum": [
                            "konfhub",
                            "ambassador"
                          ]
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1
                        },
                        "eligibility": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "^(?:[^*]|\\*\\*[^*]+\\*\\*)+$"
                          }
                        },
                        "benefits": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "group": {
                                "type": "string",
                                "minLength": 1
                              },
                              "label": {
                                "type": "string",
                                "minLength": 1
                              },
                              "detail": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "group",
                              "label"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "note": {
                          "type": "string",
                          "minLength": 1
                        },
                        "soldOut": {
                          "description": "Show a sold-out label instead of a Register action. Confirm against KonfHub before updating.",
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "audience",
                        "visible",
                        "summary",
                        "allocation",
                        "description",
                        "eligibility",
                        "benefits"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "policies": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^(?:[^*]|\\*\\*[^*]+\\*\\*)+$"
                        },
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9-]*$"
                        },
                        "appliesTo": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "liftoff",
                              "student",
                              "professional",
                              "vip",
                              "last-orbit",
                              "observer"
                            ]
                          },
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "title",
                        "text",
                        "id"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "registrationChecklist": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "title",
                        "text"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "registrationDeclaration": {
                    "type": "string",
                    "minLength": 1
                  },
                  "registration": {
                    "type": "object",
                    "properties": {
                      "buttonLabel": {
                        "type": "string",
                        "minLength": 1
                      },
                      "unavailableText": {
                        "type": "string",
                        "minLength": 1
                      },
                      "finalSaleText": {
                        "type": "string",
                        "minLength": 1
                      },
                      "profileReminder": {
                        "type": "string",
                        "minLength": 1
                      },
                      "termsLabel": {
                        "type": "string",
                        "minLength": 1
                      },
                      "widgetHeading": {
                        "type": "string",
                        "minLength": 1
                      },
                      "widgetLead": {
                        "type": "string",
                        "minLength": 1
                      },
                      "closedHeading": {
                        "type": "string",
                        "minLength": 1
                      },
                      "widgetTitle": {
                        "type": "string",
                        "minLength": 1
                      },
                      "fallbackText": {
                        "type": "string",
                        "minLength": 1
                      },
                      "fallbackLabel": {
                        "type": "string",
                        "minLength": 1
                      },
                      "referralText": {
                        "type": "string",
                        "minLength": 1
                      },
                      "soldOutLabel": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "buttonLabel",
                      "unavailableText",
                      "finalSaleText",
                      "profileReminder",
                      "termsLabel",
                      "widgetHeading",
                      "widgetLead",
                      "closedHeading",
                      "widgetTitle",
                      "fallbackText",
                      "fallbackLabel",
                      "referralText",
                      "soldOutLabel"
                    ],
                    "additionalProperties": false
                  },
                  "benefitGroups": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-z0-9-]*$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "booking": {
                    "type": "object",
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "widgetUrl": {
                        "type": "string",
                        "pattern": "^https:\\/\\/konfhub\\.com\\/widget\\/id\\/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                        "format": "uri"
                      },
                      "url": {
                        "type": "string",
                        "pattern": "^https:\\/\\/",
                        "format": "uri"
                      }
                    },
                    "required": [
                      "enabled",
                      "widgetUrl",
                      "url"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "passes",
                  "policies",
                  "registrationChecklist",
                  "registrationDeclaration",
                  "registration",
                  "benefitGroups",
                  "booking"
                ],
                "additionalProperties": false
              },
              "date": {
                "type": "string",
                "format": "date-time"
              },
              "type": {
                "type": "string",
                "const": "devfest"
              },
              "status": {
                "type": "string",
                "const": "current"
              }
            },
            "required": [
              "id",
              "name",
              "organizer",
              "timezone",
              "tagline",
              "subTagline",
              "contactEmail",
              "venue",
              "links",
              "tickets",
              "date",
              "type",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "venue": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "pattern": "^https:\\/\\/",
                "format": "uri"
              },
              "officialSpeakerIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              },
              "series": {
                "description": "Groups editions of the same event: DevFest Indore or Cloud Community Days.",
                "type": "string",
                "enum": [
                  "devfest",
                  "ccd"
                ]
              },
              "cover": {
                "description": "Id of a photograph in gallery.json taken at this event, shown on the archive card. Leave out when there is no photograph yet.",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "theme": {
                "description": "The edition's central theme, only where the organizers stated one.",
                "type": "string",
                "minLength": 1
              },
              "stats": {
                "description": "Figures reported by the organizers in their event report. Leave out any figure that was not recorded.",
                "type": "object",
                "properties": {
                  "registrations": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "rsvps": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "attendees": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "speakers": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sessions": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sponsors": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "professionals": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "students": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "approximate": {
                    "description": "True when the organizers rounded the figures, such as '600+'.",
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "recordingUrl": {
                "type": "string",
                "pattern": "^https:\\/\\/",
                "format": "uri"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "devfest",
                  "community",
                  "online"
                ]
              },
              "status": {
                "type": "string",
                "const": "past"
              }
            },
            "required": [
              "id",
              "date",
              "venue",
              "summary",
              "source",
              "officialSpeakerIds",
              "name",
              "type",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "$schema",
    "events"
  ],
  "additionalProperties": false,
  "title": "DevFest event",
  "description": "Generated from the Zod schema for content/event.json; do not edit."
}
