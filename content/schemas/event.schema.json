{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevFest event",
  "description": "Authoritative public website content. Do not store private contact details or tentative announcements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "organizer": {
      "type": "string",
      "minLength": 1
    },
    "startsAt": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "subTagline": {
      "type": "string",
      "minLength": 1
    },
    "contactEmail": {
      "type": "string",
      "format": "email"
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fullName": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "streetAddress": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "postalCode": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "mapUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "photo": {
          "type": "string",
          "pattern": "^(https://|/[^/])"
        }
      },
      "required": [
        "name",
        "fullName",
        "tag",
        "address",
        "streetAddress",
        "city",
        "region",
        "postalCode",
        "country",
        "latitude",
        "longitude",
        "mapUrl",
        "photo"
      ]
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "website": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "booking": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "cfp": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "linkedin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "instagram": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "chapter": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "youtube": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "github": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "twitter": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "codeOfConduct": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "partnerApplication": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      },
      "required": [
        "website",
        "booking",
        "cfp",
        "linkedin",
        "instagram",
        "chapter",
        "youtube",
        "github",
        "twitter",
        "codeOfConduct",
        "partnerApplication"
      ]
    },
    "booking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    }
  },
  "required": [
    "$schema",
    "id",
    "name",
    "organizer",
    "startsAt",
    "timezone",
    "tagline",
    "subTagline",
    "contactEmail",
    "venue",
    "links",
    "booking"
  ]
}
