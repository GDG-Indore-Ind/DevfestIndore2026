{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevFest faqs",
  "description": "Authoritative public website content. Do not store private contact details or tentative announcements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "event",
              "tickets"
            ]
          },
          "link": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "href",
              "label"
            ],
            "properties": {
              "href": {
                "type": "string",
                "pattern": "^/[^ ]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "required": [
          "id",
          "question",
          "answer",
          "kind"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "questions"
  ]
}
