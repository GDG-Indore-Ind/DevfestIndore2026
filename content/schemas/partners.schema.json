{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevFest partners",
  "description": "Authoritative public website content. Do not store private contact details or tentative announcements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "archiveLogoSheet": {
      "type": "string",
      "pattern": "^(https://|/[^/])"
    },
    "organizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "logoUrl": {
            "type": "string",
            "pattern": "^(https://|/[^/])"
          },
          "websiteUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "socialUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "logoShape": {
            "enum": [
              "square",
              "wide",
              "wide-large"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "title",
                "text"
              ]
            }
          },
          "archiveLogoWindow": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          },
          "partnerships": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "editionId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "kind": {
                  "enum": [
                    "sponsor",
                    "collaborator",
                    "community",
                    "media"
                  ]
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "publication": {
                  "enum": [
                    "confirmed",
                    "archived",
                    "ecosystem"
                  ]
                },
                "order": {
                  "type": "integer",
                  "minimum": 0
                },
                "source": {
                  "type": "string",
                  "pattern": "^(https://|/[^/])"
                },
                "featured": {
                  "enum": [
                    "space",
                    "technology"
                  ]
                }
              },
              "required": [
                "id",
                "editionId",
                "kind",
                "role",
                "publication"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "partnerships"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "archiveLogoSheet",
    "organizations"
  ]
}
