{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "Space",
              "AI & Robotics",
              "Keynotes",
              "Showcase",
              "Community",
              "Pre-DevFest Workshops"
            ]
          },
          "eventId": {
            "description": "The event the photograph was taken at. Leave out when it is not known.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "imageUrl": {
            "type": "string",
            "pattern": "^(https:\\/\\/|\\/[^/])"
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "pattern": "^https:\\/\\/",
            "format": "uri"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "showInGallery": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "imageUrl",
          "caption",
          "showInGallery"
        ],
        "additionalProperties": false
      }
    },
    "press": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "English summary of the headline."
          },
          "eventId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "The event the coverage is about."
          },
          "publication": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "imageUrl": {
            "type": "string",
            "pattern": "^\\/[^/]"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "title",
          "eventId",
          "imageUrl",
          "width",
          "height"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "photos"
  ],
  "additionalProperties": false,
  "title": "DevFest gallery",
  "description": "Generated from the Zod schema for content/gallery.json; do not edit."
}
