{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevFest ambassadors",
  "description": "Authoritative public website content. Do not store private contact details or tentative announcements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "directory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "personId",
          "community",
          "contactPlatforms"
        ],
        "properties": {
          "personId": {
            "type": "string",
            "minLength": 1
          },
          "community": {
            "type": "string",
            "minLength": 1
          },
          "contactPlatforms": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "enum": [
                "linkedin"
              ]
            }
          }
        }
      }
    }
  },
  "required": [
    "$schema",
    "directory"
  ]
}
