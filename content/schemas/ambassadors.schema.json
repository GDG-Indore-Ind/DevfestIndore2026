{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevFest ambassadors",
  "description": "Authoritative public website content. Do not store private contact details or tentative announcements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "ambassadors": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "college": {
            "type": "string",
            "minLength": 1
          },
          "coupon": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]+$"
          },
          "discount": {
            "type": "string",
            "minLength": 1
          },
          "city": {
            "type": "string"
          },
          "avatar": {
            "type": "string",
            "pattern": "^(https://|/[^/])"
          }
        },
        "required": [
          "name",
          "college",
          "coupon",
          "discount"
        ]
      }
    },
    "directory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "personId",
          "community",
          "preview",
          "contactPlatforms"
        ],
        "properties": {
          "personId": {
            "type": "string",
            "minLength": 1
          },
          "community": {
            "type": "string",
            "minLength": 1
          },
          "preview": {
            "type": "boolean"
          },
          "contactPlatforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "linkedin",
                "instagram",
                "twitter",
                "github",
                "website"
              ]
            }
          }
        }
      }
    }
  },
  "required": [
    "$schema",
    "ambassadors",
    "directory"
  ]
}
