{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevFest events",
  "description": "Authoritative public website content. Do not store private contact details or tentative announcements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "venue": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "DevFest",
              "Community event",
              "Online session"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "publication": {
            "enum": [
              "archived"
            ]
          },
          "officialSpeakerIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          }
        },
        "required": [
          "id",
          "title",
          "date",
          "venue",
          "kind",
          "summary",
          "source",
          "publication",
          "officialSpeakerIds"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "events"
  ]
}
