{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevFest tickets",
  "description": "Authoritative public website content. Do not store private contact details or tentative announcements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "liftoff",
              "student",
              "professional",
              "vip",
              "last-orbit",
              "observer"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "visible": {
            "description": "Show this pass card on the public tickets page. Register links hand off availability to KonfHub.",
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "allocation": {
            "type": "integer",
            "minimum": 0
          },
          "price": {
            "description": "Approved base price in INR. Omit until confirmed; zero is a real free price.",
            "type": "number",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "eligibility": {
            "type": "string",
            "minLength": 1
          },
          "benefits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "group": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "group",
                "label"
              ]
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "soldOut": {
            "description": "Show a sold-out label instead of a Register action. Confirm against KonfHub before updating.",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "audience",
          "visible",
          "summary",
          "allocation",
          "description",
          "eligibility",
          "benefits"
        ]
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "appliesTo": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "liftoff",
                "student",
                "professional",
                "vip",
                "last-orbit",
                "observer"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "text"
        ]
      }
    },
    "registrationChecklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "text"
        ]
      }
    },
    "registrationDeclaration": {
      "type": "string",
      "minLength": 1
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buttonLabel",
        "unavailableText",
        "finalSaleText",
        "profileReminder",
        "termsLabel",
        "widgetHeading",
        "widgetLead",
        "widgetTitle",
        "fallbackText",
        "fallbackLabel",
        "referralText",
        "soldOutLabel"
      ],
      "properties": {
        "buttonLabel": {
          "type": "string",
          "minLength": 1
        },
        "unavailableText": {
          "type": "string",
          "minLength": 1
        },
        "finalSaleText": {
          "type": "string",
          "minLength": 1
        },
        "profileReminder": {
          "type": "string",
          "minLength": 1
        },
        "termsLabel": {
          "type": "string",
          "minLength": 1
        },
        "widgetHeading": {
          "type": "string",
          "minLength": 1
        },
        "widgetLead": {
          "type": "string",
          "minLength": 1
        },
        "widgetTitle": {
          "type": "string",
          "minLength": 1
        },
        "fallbackText": {
          "type": "string",
          "minLength": 1
        },
        "fallbackLabel": {
          "type": "string",
          "minLength": 1
        },
        "referralText": {
          "type": "string",
          "minLength": 1
        },
        "soldOutLabel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "benefitGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "passes",
    "policies",
    "registrationChecklist",
    "registrationDeclaration",
    "registration",
    "benefitGroups"
  ]
}
