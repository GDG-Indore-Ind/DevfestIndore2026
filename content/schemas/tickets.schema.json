{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevFest tickets",
  "description": "Authoritative public website content. Do not store private contact details or tentative announcements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "liftoff",
              "student",
              "professional",
              "vip",
              "last-orbit",
              "observer"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "allocation": {
            "type": "integer",
            "minimum": 0
          },
          "price": {
            "description": "Approved base price in INR. Omit until confirmed; zero is a real free price.",
            "type": "number",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "opensAt": {
            "type": "string",
            "format": "date-time"
          },
          "closesAt": {
            "type": "string",
            "format": "date-time"
          },
          "eligibility": {
            "type": "string",
            "minLength": 1
          },
          "benefits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "audience",
          "summary",
          "allocation",
          "description",
          "opensAt",
          "closesAt",
          "eligibility",
          "benefits",
          "note"
        ]
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "appliesTo": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "liftoff",
                "student",
                "professional",
                "vip",
                "last-orbit",
                "observer"
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "text"
        ]
      }
    },
    "registrationChecklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "text"
        ]
      }
    },
    "bookingSteps": {
      "$ref": "#/properties/registrationChecklist"
    },
    "registrationDeclaration": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "$schema",
    "passes",
    "policies",
    "registrationChecklist",
    "registrationDeclaration",
    "bookingSteps"
  ]
}
