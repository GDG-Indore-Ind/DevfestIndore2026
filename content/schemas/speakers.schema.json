{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevFest speakers",
  "description": "Authoritative public website content. Do not store private contact details or tentative announcements.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "personId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "editionId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "publication": {
            "enum": [
              "confirmed",
              "archived"
            ]
          }
        },
        "required": [
          "id",
          "personId",
          "editionId",
          "publication"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "speakers"
  ]
}
