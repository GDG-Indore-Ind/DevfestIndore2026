{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Public page copy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "guidelines",
    "partners",
    "venue",
    "home",
    "tickets",
    "faq"
  ],
  "definitions": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "intro": {
      "type": "object",
      "required": [
        "title",
        "description",
        "lead"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/text"
        },
        "description": {
          "$ref": "#/definitions/text"
        },
        "lead": {
          "$ref": "#/definitions/text"
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "guidelines": {
      "allOf": [
        {
          "$ref": "#/definitions/intro"
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "navigationLabel",
        "sections",
        "supportText",
        "supportLabel"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/text"
        },
        "description": {
          "$ref": "#/definitions/text"
        },
        "lead": {
          "$ref": "#/definitions/text"
        },
        "navigationLabel": {
          "$ref": "#/definitions/text"
        },
        "supportText": {
          "$ref": "#/definitions/text"
        },
        "supportLabel": {
          "$ref": "#/definitions/text"
        },
        "sections": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "policyIds"
            ],
            "properties": {
              "id": {
                "enum": [
                  "before-booking",
                  "entry",
                  "eligibility",
                  "workshops",
                  "ticket-policy",
                  "support"
                ]
              },
              "title": {
                "$ref": "#/definitions/text"
              },
              "policyIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/definitions/text"
                }
              }
            }
          }
        }
      }
    },
    "partners": {
      "allOf": [
        {
          "$ref": "#/definitions/intro"
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationTitle",
        "applicationText",
        "applicationPoints",
        "applicationButton",
        "contactText",
        "archiveLabel",
        "revealed",
        "revealTitle",
        "revealText",
        "revealButton",
        "revealLead",
        "revealDescription"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/text"
        },
        "description": {
          "$ref": "#/definitions/text"
        },
        "lead": {
          "$ref": "#/definitions/text"
        },
        "applicationTitle": {
          "$ref": "#/definitions/text"
        },
        "applicationText": {
          "$ref": "#/definitions/text"
        },
        "applicationButton": {
          "$ref": "#/definitions/text"
        },
        "contactText": {
          "$ref": "#/definitions/text"
        },
        "archiveLabel": {
          "$ref": "#/definitions/text"
        },
        "applicationPoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "text"
            ],
            "properties": {
              "title": {
                "$ref": "#/definitions/text"
              },
              "text": {
                "$ref": "#/definitions/text"
              }
            }
          }
        },
        "revealed": {
          "type": "boolean"
        },
        "revealTitle": {
          "$ref": "#/definitions/text"
        },
        "revealText": {
          "$ref": "#/definitions/text"
        },
        "revealButton": {
          "$ref": "#/definitions/text"
        },
        "revealLead": {
          "$ref": "#/definitions/text"
        },
        "revealDescription": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "venue": {
      "allOf": [
        {
          "$ref": "#/definitions/intro"
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapTitle",
        "arrivalTitle",
        "registrationLabel",
        "entryTitle",
        "supportTitle",
        "supportText",
        "supportLabel",
        "entrySummary"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/text"
        },
        "description": {
          "$ref": "#/definitions/text"
        },
        "lead": {
          "$ref": "#/definitions/text"
        },
        "mapTitle": {
          "$ref": "#/definitions/text"
        },
        "arrivalTitle": {
          "$ref": "#/definitions/text"
        },
        "registrationLabel": {
          "$ref": "#/definitions/text"
        },
        "entryTitle": {
          "$ref": "#/definitions/text"
        },
        "supportTitle": {
          "$ref": "#/definitions/text"
        },
        "supportText": {
          "$ref": "#/definitions/text"
        },
        "supportLabel": {
          "$ref": "#/definitions/text"
        },
        "entrySummary": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programmeTitle",
        "programmeTagline",
        "programmeStatus",
        "historySince",
        "historyTitle",
        "historyLead",
        "historyRecentLabel",
        "ecosystemTitle",
        "ecosystemLead",
        "ecosystemHistoryLabel",
        "galleryTitle",
        "galleryLead",
        "galleryDescription",
        "heroLead",
        "heroDescription",
        "artworkCaption",
        "historyEyebrow",
        "venueLead",
        "pastSponsorsTitle",
        "pastSponsorsLink"
      ],
      "properties": {
        "programmeTitle": {
          "$ref": "#/definitions/text"
        },
        "programmeTagline": {
          "$ref": "#/definitions/text"
        },
        "programmeStatus": {
          "$ref": "#/definitions/text"
        },
        "historySince": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2026
        },
        "historyTitle": {
          "$ref": "#/definitions/text"
        },
        "historyLead": {
          "$ref": "#/definitions/text"
        },
        "historyRecentLabel": {
          "$ref": "#/definitions/text"
        },
        "ecosystemTitle": {
          "$ref": "#/definitions/text"
        },
        "ecosystemLead": {
          "$ref": "#/definitions/text"
        },
        "ecosystemHistoryLabel": {
          "$ref": "#/definitions/text"
        },
        "galleryTitle": {
          "$ref": "#/definitions/text"
        },
        "galleryLead": {
          "$ref": "#/definitions/text"
        },
        "galleryDescription": {
          "$ref": "#/definitions/text"
        },
        "heroLead": {
          "$ref": "#/definitions/text"
        },
        "heroDescription": {
          "$ref": "#/definitions/text"
        },
        "artworkCaption": {
          "$ref": "#/definitions/text"
        },
        "historyEyebrow": {
          "$ref": "#/definitions/text"
        },
        "venueLead": {
          "$ref": "#/definitions/text"
        },
        "pastSponsorsTitle": {
          "$ref": "#/definitions/text"
        },
        "pastSponsorsLink": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "tickets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "lead",
        "endedLead",
        "supportText",
        "guidelinesLabel"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/text"
        },
        "lead": {
          "$ref": "#/definitions/text"
        },
        "endedLead": {
          "$ref": "#/definitions/text"
        },
        "supportText": {
          "$ref": "#/definitions/text"
        },
        "guidelinesLabel": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "faq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "lead",
        "eventTitle",
        "eventLead",
        "ticketsTitle",
        "ticketsLead",
        "contactText"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/text"
        },
        "lead": {
          "$ref": "#/definitions/text"
        },
        "eventTitle": {
          "$ref": "#/definitions/text"
        },
        "eventLead": {
          "$ref": "#/definitions/text"
        },
        "ticketsTitle": {
          "$ref": "#/definitions/text"
        },
        "ticketsLead": {
          "$ref": "#/definitions/text"
        },
        "contactText": {
          "$ref": "#/definitions/text"
        }
      }
    }
  }
}
