{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Public page copy",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "guidelines", "partners", "venue"],
  "definitions": {
    "text": { "type": "string", "minLength": 1 },
    "intro": {
      "type": "object",
      "required": ["title", "description", "lead"],
      "properties": {
        "title": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" },
        "lead": { "$ref": "#/definitions/text" }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "guidelines": {
      "allOf": [{ "$ref": "#/definitions/intro" }],
      "type": "object",
      "additionalProperties": false,
      "required": ["navigationLabel", "bookingTitle", "sections", "supportText", "supportLabel"],
      "properties": {
        "title": { "$ref": "#/definitions/text" }, "description": { "$ref": "#/definitions/text" }, "lead": { "$ref": "#/definitions/text" },
        "navigationLabel": { "$ref": "#/definitions/text" }, "bookingTitle": { "$ref": "#/definitions/text" },
        "supportText": { "$ref": "#/definitions/text" }, "supportLabel": { "$ref": "#/definitions/text" },
        "sections": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "title", "policyIds"],
            "properties": {
              "id": { "enum": ["before-booking", "entry", "eligibility", "workshops", "ticket-policy", "support"] },
              "title": { "$ref": "#/definitions/text" },
              "policyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/text" } }
            }
          }
        }
      }
    },
    "partners": {
      "allOf": [{ "$ref": "#/definitions/intro" }], "type": "object", "additionalProperties": false,
      "required": ["applicationTitle", "applicationText", "applicationPoints", "applicationButton", "contactText", "archiveLabel"],
      "properties": {
        "title": { "$ref": "#/definitions/text" }, "description": { "$ref": "#/definitions/text" }, "lead": { "$ref": "#/definitions/text" },
        "applicationTitle": { "$ref": "#/definitions/text" }, "applicationText": { "$ref": "#/definitions/text" },
        "applicationButton": { "$ref": "#/definitions/text" }, "contactText": { "$ref": "#/definitions/text" }, "archiveLabel": { "$ref": "#/definitions/text" },
        "applicationPoints": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["title", "text"], "properties": { "title": { "$ref": "#/definitions/text" }, "text": { "$ref": "#/definitions/text" } } } }
      }
    },
    "venue": {
      "allOf": [{ "$ref": "#/definitions/intro" }], "type": "object", "additionalProperties": false,
      "required": ["mapTitle", "arrivalTitle", "registrationLabel", "entryTitle", "supportTitle", "supportText", "supportLabel"],
      "properties": {
        "title": { "$ref": "#/definitions/text" }, "description": { "$ref": "#/definitions/text" }, "lead": { "$ref": "#/definitions/text" },
        "mapTitle": { "$ref": "#/definitions/text" }, "arrivalTitle": { "$ref": "#/definitions/text" }, "registrationLabel": { "$ref": "#/definitions/text" }, "entryTitle": { "$ref": "#/definitions/text" },
        "supportTitle": { "$ref": "#/definitions/text" }, "supportText": { "$ref": "#/definitions/text" }, "supportLabel": { "$ref": "#/definitions/text" }
      }
    }
  }
}
